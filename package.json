{
  "name": "@qualithm/platform",
  "version": "0.0.0",
  "description": "TypeScript client for the Qualithm Platform API, generated from its OpenAPI spec.",
  "private": false,
  "type": "module",
  "keywords": [
    "qualithm",
    "typescript",
    "openapi",
    "client",
    "connected-products"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "Qualithm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qualithm/platform-sdk-js.git"
  },
  "homepage": "https://github.com/qualithm/platform-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/qualithm/platform-sdk-js/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "deno": "./dist/index.js",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "docs": "typedoc",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate": "scripts/generate",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "bun run clean && bun run build",
    "test": "vitest run src/__tests__/unit",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run --coverage src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration --passWithNoTests",
    "test:unit": "vitest run src/__tests__/unit",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "validate:runtime": "bun run scripts/validate-runtime.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "@vitest/coverage-istanbul": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.5.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.6.0",
    "jiti": "2.7.0",
    "prettier": "3.8.4",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "vite": "8.0.16",
    "markdown-it": "14.3.2",
    "linkify-it": "5.0.2"
  }
}
